d3-4d75-907a-7de6dc4141ac.__CR0,0,600,450_PT0_SX600_V1___.jpg\" class=\"background-image\" data-src=\"https:\/\/m.media-amazon.com\/images\/S\/aplus-media-library-service-media\/5b4338f0-36d3-4d75-907a-7de6dc4141ac.__CR0,0,600,450_PT0_SX600_V1___.jpg\"\u003e\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e","brand":"KIWI Design","offers":[{"title":"Black","offer_id":48191714885854,"sku":null,"price":30.0,"currency_code":"USD","in_stock":true},{"title":"White","offer_id":48191714918622,"sku":null,"price":30.0,"currency_code":"USD","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0272\/9476\/1037\/files\/rn-image_picker_lib_temp_58cf6d96-e0b4-4af9-ba19-9f7bed3e1153.jpg?v=1777807832"},{"product_id":"kiwi-design-h4-boost-halo-comfort-battery-head-strap-for-meta-quest-3-3s","title":"KIWI design H4 Boost Halo Comfort Battery Head Strap for Meta Quest 3\/3S","description":"\u003cdiv class=\"product-info__block-item\" data-block-id=\"description\" data-block-type=\"description\"\u003e\n\u003cdiv class=\"product-info__description\"\u003e\n\u003cdiv class=\"prose\"\u003e\n\u003cul\u003e\n\u003cli data-line=\"true\" data-line-index=\"2\" data-zone-id=\"0\"\u003e\u003cspan\u003e\u003cstrong\u003efor Quest 3\/3S\u003c\/strong\u003e\u003c\/span\u003e\u003c\/li\u003e\n\u003cli data-line=\"true\" data-line-index=\"2\" data-zone-id=\"0\"\u003e\u003cspan\u003e\u003cstrong\u003eExtended Playtime with Enhanced Battery:\u003c\/strong\u003eEnjoy uninterrupted gaming with up to 3 hours of additional battery life; play longer without worrying about running out of power; tailored to your usage scenarios for maximum performance.\u003c\/span\u003e\u003c\/li\u003e\n\u003cli data-line=\"true\" data-line-index=\"3\" data-zone-id=\"0\"\u003e\u003cspan\u003e\u003cstrong\u003eDual Fast Charging \u0026amp; Two Times Faster:\u003c\/strong\u003ePower up both H4 Boost and Quest 3\/3S simultaneously with the Dual Boost Charging system. \u003cstrong\u003eFully recharge both in just 2.5 hours with a 45W adapter\u003c\/strong\u003e, delivering 25W power to your Quest 3\/3S while charging the internal battery.\u003c\/span\u003e\u003c\/li\u003e\n\u003cli data-line=\"true\" data-line-index=\"4\" data-zone-id=\"0\"\u003e\u003cspan\u003e\u003cstrong\u003eZero Facial Pressure \u0026amp; Custom Fit:\u003c\/strong\u003e Adaptive front headrest design evenly distributes the weight of Quest 3\/3S, reducing facial pressure and offering a comfortable fit for extended use, even without the facial interface; elastic side straps, adjustable top strap, and soft rear cushion ensure a secure fit for all head sizes, ideal for gaming, movie-watching, and productivity.\u003c\/span\u003e\u003c\/li\u003e\n\u003cli data-line=\"true\" data-line-index=\"5\" data-zone-id=\"0\"\u003e\u003cspan\u003e\u003cstrong\u003eAdjustable FOV \u0026amp; All-Day Ventilation:\u003c\/strong\u003e The damping sider allows front-to-back FOV adjustments, while the headset lever knob provides up-and-down alignment for a clearer experience; the innovative ventilation design in the fore cushion keeps the head and face cool during long sessions.\u003c\/span\u003e\u003c\/li\u003e\n\u003cli data-line=\"true\" data-line-index=\"6\" data-zone-id=\"0\"\u003e\u003cspan\u003e\u003cstrong\u003eLie Down Comfortably:\u003c\/strong\u003e The integrated adjustment knob enables effortless fitting; enjoy total comfort while lying down on your couch or bed, making it easy to fully immerse yourself in gaming or movies with the H4 Head Strap on Quest 3\/3S\u003c\/span\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cdiv class=\"prose\"\u003e\n\u003ch3\u003e\u003cimg alt=\"quest 3s head strap\" src=\"https:\/\/m.media-amazon.com\/images\/S\/aplus-media-library-service-media\/8c4a4e2b-184e-4127-93ee-3972aa10d609.__CR0,0,600,450_PT0_SX600_V1___.jpg\" class=\"background-image\" data-src=\"https:\/\/m.media-amazon.com\/images\/S\/aplus-media-library-service-media\/8c4a4e2b-184e-4127-93ee-3972aa10d609.__CR0,0,600,450_PT0_SX600_V1___.jpg\"\u003e\u003c\/h3\u003e\n\u003cdiv lang=\"en_US\"\u003e\n\u003cdiv class=\"aplus-v2 mobile celwidget\" cel_widget_id=\"m-aplus\" data-csa-c-id=\"v2sqyi-ahwhcq-ixdbdp-b5qcmm\" data-cel-widget=\"m-aplus\"\u003e\n\u003cdiv class=\"aplus-content-wrapper\"\u003e\n\u003cdiv class=\"celwidget aplus-module premium-module-2-fullbackground-image aplus-premium\" cel_widget_id=\"aplus-m-premium-module-2-fullbackground-image\" data-csa-c-id=\"vsgbbd-jz4f2s-ljpjar-2q8miw\" data-cel-widget=\"aplus-m-premium-module-2-fullbackground-image\"\u003e\n\u003cdiv class=\"a-section a-spacing-none premium-aplus premium-aplus-module-2\"\u003e\n\u003cdiv class=\"a-section a-spacing-none\"\u003e\u003cimg alt=\"quest 3 head strap\" src=\"https:\/\/m.media-amazon.com\/images\/S\/aplus-media-library-service-media\/f3c1bd53-4e41-4532-9a69-c5caad992abb.__CR0,0,600,450_PT0_SX600_V1___.jpg\" class=\"background-image\" data-src=\"https:\/\/m.media-amazon.com\/images\/S\/aplus-media-library-service-media\/f3c1bd53-4e41-4532-9a69-c5caad992abb.__CR0,0,600,450_PT0_SX600_V1___.jpg\"\u003e\u003c\/div\u003e\n\u003cdiv class=\"a-section a-text-center\"\u003e\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"celwidget aplus-module premium-module-2-fullbackground-image aplus-premium\" cel_widget_id=\"aplus-m-premium-module-2-fullbackground-image\" data-csa-c-id=\"z71oqc-wl4pj-a80438-s35oca\" data-cel-widget=\"aplus-m-premium-module-2-fullbackground-image\"\u003e\n\u003cdiv class=\"a-section a-spacing-none premium-aplus premium-aplus-module-2\"\u003e\n\u003cdiv class=\"a-section a-spacing-none\"\u003e\u003cimg alt=\"quest 3 head strap\" src=\"https:\/\/m.media-amazon.com\/images\/S\/aplus-media-library-service-media\/076ad30e-eb32-4f86-95ff-178c0653b80d.__CR0,0,600,450_PT0_SX600_V1___.jpg\" class=\"background-image\" data-src=\"https:\/\/m.media-amazon.com\/images\/S\/aplus-media-library-service-media\/076ad30e-eb32-4f86-95ff-178c0653b80d.__CR0,0,600,450_PT0_SX600_V1___.jpg\"\u003e\u003c\/div\u003e\n\u003cdiv class=\"a-section a-text-center\"\u003e\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"celwidget aplus-module premium-module-2-fullbackground-image aplus-premium\" cel_widget_id=\"aplus-m-premium-module-2-fullbackground-image\" data-csa-c-id=\"7o9j65-sj6nyn-u7x61o-unetag\" data-cel-widget=\"aplus-m-premium-module-2-fullbackground-image\"\u003e\n\u003cdiv class=\"a-section a-spacing-none premium-aplus premium-aplus-module-2\"\u003e\n\u003cdiv class=\"a-section a-spacing-none\"\u003e\n\u003cimg alt=\"meta quest 3s\" src=\"https:\/\/m.media-amazon.com\/images\/S\/aplus-media-library-service-media\/25959c60-ca99-4373-92a8-da95315fb783.__CR0,0,600,450_PT0_SX600_V1___.jpg\" class=\"background-image\" data-src=\"https:\/\/m.media-amazon.com\/images\/S\/aplus-media-library-service-media\/25959c60-ca99-4373-92a8-da95315fb783.__CR0,0,600,450_PT0_SX600_V1___.jpg\"\u003e\u003cimg alt=\"meta quest 3\" src=\"https:\/\/m.media-amazon.com\/images\/S\/aplus-media-library-service-media\/3f6ccd5e-fe7d-4b7d-9d05-5a4bd830b0a3.__CR0,0,600,450_PT0_SX600_V1___.jpg\"\u003e\u003cimg alt=\"meta quest 3S accessories\" src=\"https:\/\/m.media-amazon.com\/images\/S\/aplus-media-library-service-media\/150e870d-3ac5-4af7-abe9-183a2cbda370.__CR0,0,600,450_PT0_SX600_V1___.png\"\u003e\u003cimg alt=\"meta quest 3 \" src=\"https:\/\/m.media-amazon.com\/images\/S\/aplus-media-library-service-media\/47e8a5e9-5785-4073-9ead-886321cb1f4f.__CR0,0,600,450_PT0_SX600_V1___.jpg\"\u003e\u003cimg alt=\"quest 3s\" src=\"https:\/\/m.media-amazon.com\/images\/S\/aplus-media-library-service-media\/788cf7bd-a859-4bb4-8697-fc424dac19ab.__CR0,0,600,450_PT0_SX600_V1___.jpg\"\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003ch2 class=\"h2\" reveal-on-scroll=\"true\"\u003e\u003cspan\u003e \u003c\/span\u003e\u003c\/h2\u003e\n\u003c\/div\u003e\n\u003cp\u003e \u003c\/p\u003e\n\u003cdiv class=\"scrollable-with-controls\"\u003e\u003cproduct-recommendations product=\"7237401247857\" limit=\"6\" intent=\"related\" class=\"contents\"\u003e\u003cscroll-carousel selector=\"product-card\" id=\"scroll-area-template--18883685089393__related_products_LtKXtT\" class=\"scroll-area bleed is-scrollable\"\u003e\u003creveal-items selector=\".product-list \u0026gt; *\" style=\"box-sizing: border-box; border-style: solid; border-width: 0px; border-color: rgba(0, 0, 0, 0.12); opacity: 1;\"\u003e\u003cproduct-list class=\"product-list\"\u003e\u003cproduct-card handle=\"g4-pro-performance-controller-grips\" class=\"product-card product-card--blends product-card--show-secondary-media text-custom is-selected\"\u003e\n\u003cdiv class=\"product-card__figure\"\u003e\u003c\/div\u003e\n\u003c\/product-card\u003e\u003c\/product-list\u003e\u003c\/reveal-items\u003e\u003c\/scroll-carousel\u003e\u003c\/product-recommendations\u003e\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e","brand":"KIWI Design","offers":[{"title":"Default Title","offer_id":48191716983006,"sku":null,"price":70.0,"currency_code":"USD","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0272\/9476\/1037\/files\/rn-image_picker_lib_temp_d9726244-73a2-4c46-851a-039f1586bdff.jpg?v=1777808434"},{"product_id":"kiwi-design-v4-facial-interface-face-pads-compatible-meta-quest-3s-only-2pcs","title":"KIWI design V4 Facial Interface Face Pads Compatible Meta Quest 3S Only - (2pcs)","description":"\u003cdiv class=\"product-info__block-item\" data-block-id=\"description\" data-block-type=\"description\"\u003e\n\u003cdiv class=\"product-info__description\"\u003e\n\u003cdiv class=\"prose\"\u003e\n\u003cul\u003e\n\u003cli data-line=\"true\" data-line-index=\"0\" data-zone-id=\"0\"\u003e\u003cspan\u003e\u003cstrong\u003eComfortable Replaceable Face Pad Set for Quest 3S:\u003c\/strong\u003e Made with soft, skin-friendly PU leather and 12 mm thick memory foam, offering a skin-friendly and sweat-resistant surface; perfect for long gaming sessions or sharing with family and friends\u003c\/span\u003e\u003c\/li\u003e\n\u003cli data-line=\"true\" data-line-index=\"1\" data-zone-id=\"0\"\u003e\u003cspan\u003e\u003cstrong\u003eReduced Pressure, More Playtime:\u003c\/strong\u003e Expanded mask frame evenly distributes weight across your face, minimizing pressure and fatigue for extended comfort during long sessions; comes with a soft silicone nose guard for light blocking\u003c\/span\u003e\u003c\/li\u003e\n\u003cli data-line=\"true\" data-line-index=\"2\" data-zone-id=\"0\"\u003e\u003cspan\u003e\u003cstrong\u003eStay Cool and Immersed:\u003c\/strong\u003e Over 20 L-shaped ventilation holes ensure continuous airflow to prevent overheating and reduce lens fogging, keeping you cool while blocking light for total immersion\u003c\/span\u003e\u003c\/li\u003e\n\u003cli data-line=\"true\" data-line-index=\"3\" data-zone-id=\"0\"\u003e\u003cspan\u003e\u003cstrong\u003ePerfect Fit for Every Face:\u003c\/strong\u003e Special contoured and precision cutting pads provide a snug fit for all face shapes, including glass wearers, ensuring secure comfort and enhanced immersion without slip or discomfort\u003c\/span\u003e\u003c\/li\u003e\n\u003cli data-line=\"true\" data-line-index=\"4\" data-zone-id=\"0\"\u003e\u003cspan\u003e\u003cstrong\u003eDurable and Easy to Clean:\u003c\/strong\u003e The washable PU leather and wide memory foam maintain softness and shape through over 200 installation cycles, ensuring long-lasting comfort and hygiene with minimal maintenance\u003c\/span\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003csection id=\"shopify-section-template--18883685941361__image_with_text_overlay_DTU6TG\" class=\"shopify-section shopify-section--image-with-text-overlay\"\u003e\n\u003cdiv class=\"section   section-blends section-full text-custom\"\u003e\u003cimage-banner reveal-on-scroll=\"true\" class=\"c