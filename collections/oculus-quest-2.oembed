d_Strap_close_up-4_c25523b0-a971-4e06-8c73-054f8cd6cd1a.jpg?v=1751020038\u0026amp;width=500 500w, \/\/www.kiwidesign.com\/cdn\/shop\/files\/KIWI_design_K4_Duo_Head_Strap_close_up-4_c25523b0-a971-4e06-8c73-054f8cd6cd1a.jpg?v=1751020038\u0026amp;width=600 600w, \/\/www.kiwidesign.com\/cdn\/shop\/files\/KIWI_design_K4_Duo_Head_Strap_close_up-4_c25523b0-a971-4e06-8c73-054f8cd6cd1a.jpg?v=1751020038\u0026amp;width=700 700w, \/\/www.kiwidesign.com\/cdn\/shop\/files\/KIWI_design_K4_Duo_Head_Strap_close_up-4_c25523b0-a971-4e06-8c73-054f8cd6cd1a.jpg?v=1751020038\u0026amp;width=800 800w, \/\/www.kiwidesign.com\/cdn\/shop\/files\/KIWI_design_K4_Duo_Head_Strap_close_up-4_c25523b0-a971-4e06-8c73-054f8cd6cd1a.jpg?v=1751020038\u0026amp;width=1000 1000w, \/\/www.kiwidesign.com\/cdn\/shop\/files\/KIWI_design_K4_Duo_Head_Strap_close_up-4_c25523b0-a971-4e06-8c73-054f8cd6cd1a.jpg?v=1751020038\u0026amp;width=1200 1200w, \/\/www.kiwidesign.com\/cdn\/shop\/files\/KIWI_design_K4_Duo_Head_Strap_close_up-4_c25523b0-a971-4e06-8c73-054f8cd6cd1a.jpg?v=1751020038\u0026amp;width=1400 1400w\" width=\"1500\" height=\"1500\" loading=\"lazy\" sizes=\"(max-width: 999px) 100vw, min(800px, 50vw)\"\u003e\u003c\/div\u003e\n\u003cdiv class=\"media-with-text__content  bg-custom text-custom\"\u003e\n\u003cdiv class=\"prose break-all place-self-center text-center\" reveal-on-scroll=\"true\"\u003e\n\u003cp class=\"h2\"\u003eTurn. Fit. Share.\u003c\/p\u003e\n\u003cp\u003eA simple twist adjusts the fit—so it’s always ready, whether it’s for you, your kid, or your co-op partner.\u003c\/p\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/media-with-text\u003e\u003c\/div\u003e\n\u003c\/section\u003e\n\u003csection id=\"shopify-section-template--17854659919985__multi_column_7y3Eem\" class=\"shopify-section shopify-section--multi-column\"\u003e\n\u003cdiv class=\"section   section-full bg-custom text-custom\"\u003e\n\u003cdiv class=\"section-stack\"\u003e\n\u003csection-header class=\"section-header justify-start justify-items-start text-start\"\u003e\n\u003cdiv class=\"prose\"\u003e\n\u003ch2 class=\"h2\" reveal-on-scroll=\"true\"\u003e\u003csplit-lines\u003e\u003cspan\u003eNow for the real headliner.\u003c\/span\u003e\u003c\/split-lines\u003e\u003c\/h2\u003e\n\u003cp\u003e\u003cstrong\u003eThe built-in audio system isn’t just along for the ride—it’s here to transform how VR sounds, feels, and flows.\u003c\/strong\u003e\u003c\/p\u003e\n\u003c\/div\u003e\n\u003c\/section-header\u003e\n\u003cdiv class=\"multi-column scroll-area bleed md:unbleed\"\u003e\n\u003cdiv class=\"multi-column__item justify-start snap-start\"\u003e\n\u003cvideo-media autoplay=\"autoplay\" loaded=\"\" can-play=\"\" playing=\"\"\u003e\u003cvideo playsinline=\"true\" muted=\"muted\" loop=\"loop\" preload=\"metadata\" class=\"rounded\" aria-label=\"KIWI design K4 Duo Head Strap Earphone-1\" poster=\"https:\/\/www.kiwidesign.com\/cdn\/shop\/files\/preview_images\/98b2c75c8e624cfba19f68fe097d8c3b.thumbnail.0000000000_small.jpg?v=1751853117\"\u003e\u003c\/video\u003e\u003c\/video-media\u003e\n\u003cdiv class=\"v-stack gap-4 text-start\"\u003e\n\u003cp class=\"h4\"\u003eSilent control. Instant switch.\u003c\/p\u003e\n\u003cdiv class=\"prose\"\u003e\n\u003cp\u003eWith a single flick, move your audio wherever it needs to be—Quest 3, K4 Duo, or back again.\u003c\/p\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"multi-column__item justify-start snap-start\"\u003e\n\u003cvideo-media autoplay=\"autoplay\" loaded=\"\" can-play=\"\" playing=\"\"\u003e\u003cvideo playsinline=\"true\" muted=\"muted\" loop=\"loop\" preload=\"metadata\" class=\"rounded\" aria-label=\"KIWI design K4 Duo Head Strap Earphone-2\" poster=\"https:\/\/www.kiwidesign.com\/cdn\/shop\/files\/preview_images\/05483cb837fa49bfa0bedc00a2efcd60.thumbnail.0000000000_small.jpg?v=1751853118\"\u003e\u003c\/video\u003e\u003c\/video-media\u003e\n\u003cdiv class=\"v-stack gap-4 text-start\"\u003e\n\u003cp class=\"h4\"\u003eFolds down. Stays out of the way.\u003c\/p\u003e\n\u003cdiv class=\"prose\"\u003e\n\u003cp\u003eThe earphones rotate down with ease, and tuck away just as neatly.\u003c\/p\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"multi-column__item justify-start snap-start\"\u003e\n\u003cvideo-media autoplay=\"autoplay\"\u003e\u003cvideo playsinline=\"true\" muted=\"muted\" loop=\"loop\" preload=\"metadata\" class=\"rounded\" aria-label=\"KIWI design K4 Duo Head Strap Earphone-3\" poster=\"https:\/\/www.kiwidesign.com\/cdn\/shop\/files\/preview_images\/2080f39091ec4c748e5b6275e3664c0a.thumbnail.0000000000_small.jpg?v=1751853118\"\u003e\u003c\/video\u003e\u003c\/video-media\u003e\n\u003cdiv class=\"v-stack gap-4 text-start\"\u003e\n\u003cp class=\"h4\"\u003eShifts with you.\u003c\/p\u003e\n\u003cdiv class=\"prose\"\u003e\n\u003cp\u003eThe arms tilt vertically to match your natural posture—no pressure, just perfect alignment.\u003c\/p\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"multi-column__item justify-start snap-start\"\u003e\n\u003cvideo-media autoplay=\"autoplay\"\u003e\u003cvideo playsinline=\"true\" muted=\"muted\" loop=\"loop\" preload=\"metadata\" class=\"rounded\" aria-label=\"KIWI design K4 Duo Head Strap Earphone-4\" poster=\"https:\/\/www.kiwidesign.com\/cdn\/shop\/files\/preview_images\/89d6b1b1c2b24ad2a8d4dc7be26ce2fb.thumbnail.0000000000_small.jpg?v=1751853118\"\u003e\u003c\/video\u003e\u003c\/video-media\u003e\n\u003cdiv class=\"v-stack gap-4 text-start\"\u003e\n\u003cp class=\"h4\"\u003eDialed in to the last detail.\u003c\/p\u003e\n\u003cdiv class=\"prose\"\u003e\n\u003cp\u003eA final adjustment brings the earphones exactly where they should be—for fit that disappears.\u003c\/p\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/section\u003e\n\u003csection id=\"shopify-section-template--1785465991